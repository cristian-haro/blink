# Configuración del Puerto del Servidor
PORT=3000

# URL de Conexión a Redis
# En local con Docker Compose suele ser: redis://redis-service:6379
# En producción puede ser diferente si usas un Redis gestionado.
REDIS_URL=redis://redis-service:6379

# Límite de carga de archivos (debe coincidir con la configuración del servidor)
# 50mb es el default actual en el código
MAX_BODY_SIZE=50mb

# Rate Limiting (Opcional)
# RATE_LIMIT_WINDOW_MS=3600000
# RATE_LIMIT_MAX_REQUESTS=100
